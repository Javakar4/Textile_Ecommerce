{
  "name": "monorepo",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "client": "pnpm --filter @apps/client dev",
    "server": "pnpm --filter @apps/server dev",
    "lint": "pnpm -r lint",
    "admin": "pnpm --filter @apps/admin dev",
    "all": "pnpm -r run dev",
    "build:client": "pnpm --filter @apps/client build",
    "build:admin": "pnpm --filter @apps/admin build"
  }
}
